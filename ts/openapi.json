  "components": {
    "schemas": {
      "BrowserSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "sandbox_id": {
            "type": "string",
            "title": "Sandbox Id"
          },
          "status": {
            "$ref": "#/components/schemas/BrowserSessionState"
          },
          "cdp_url": {
            "type": "string",
            "title": "Cdp Url"
          },
          "viewer_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Viewer Url"
          },
          "display_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Url"
          },
          "profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Id"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "sandbox_id",
          "status",
          "cdp_url"
        ],
        "title": "BrowserSessionResponse",
        "description": "Ready browser session endpoints returned only to the owning SDK client."
      },
      "BrowserSessionState": {
        "type": "string",
        "enum": [
          "created",
          "starting",
          "ready",
          "stopping",
          "error",
          "deleted"
        ],
        "title": "BrowserSessionState",
        "description": "Browser session lifecycle states."
      },
      "BrowserViewportRequest": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 7680.0,
            "minimum": 640.0,
            "title": "Width",
            "default": 1280
          },
          "height": {
            "type": "integer",
            "maximum": 4320.0,
            "minimum": 480.0,
            "title": "Height",
            "default": 720
          }
        },
        "type": "object",
        "title": "BrowserViewportRequest",
        "description": "Requested browser viewport in CSS pixels."
      },
      "CapabilitiesResponse": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1,
            "title": "Protocol Version",
            "default": 1
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities",
            "default": [
              "sandbox.create",
              "sandbox.delete",
              "sandbox.exec",
              "files.read",
              "files.write",
              "browser.create",
              "browser.delete",
              "browser.endpoints",
              "browser.exec",
              "browser.files",
              "browser.events",
              "computer.create",
              "computer.delete",
              "computer.endpoints",
              "computer.exec",
              "computer.files",
              "computer.browser",
              "computer.events",
              "events",
              "diagnostics"
            ]
          }
        },
        "type": "object",
        "title": "CapabilitiesResponse",
        "description": "Runtime protocol and feature discovery."
      },
      "ComputerBrowserResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "closed",
              "error"
            ],
            "title": "Status"
          },
          "cdp_url": {
            "anyOf": [
