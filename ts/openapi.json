{
  "openapi": "3.1.0",
  "info": {
    "title": "SmolVM SDK bridge",
    "summary": "A private local bridge for SmolVM SDK clients.",
    "version": "1"
  },
  "paths": {
    "/sdk/v1/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_sdk_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sdk/v1/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_sdk_v1_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/sdk/v1/diagnostics": {
      "get": {
        "summary": "Diagnostics",
        "operationId": "diagnostics_sdk_v1_diagnostics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes": {
      "get": {
        "summary": "List Sandboxes",
        "operationId": "listSandboxes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SandboxResponse"
                  },
                  "type": "array",
                  "title": "Response Listsandboxes"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Sandbox",
        "operationId": "createSandbox",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSandboxRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes/{sandbox_id}": {
      "get": {
        "summary": "Get Sandbox",
        "operationId": "getSandbox",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Sandbox",
        "operationId": "deleteSandbox",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes/{sandbox_id}/desktop": {
      "get": {
        "summary": "Get Sandbox Desktop",
        "operationId": "getSandboxDesktop",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes/{sandbox_id}/cancel": {
      "post": {
        "summary": "Cancel Sandbox Operation",
        "description": "Stop an in-flight operation by deleting its session VM.",
        "operationId": "cancel_sandbox_operation_sandboxes__sandbox_id__cancel_post",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes/{sandbox_id}/exec": {
      "post": {
        "summary": "Exec Command",
        "operationId": "execCommand",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sandboxes/{sandbox_id}/files": {
      "put": {
        "summary": "Write File",
        "operationId": "write_file_sandboxes__sandbox_id__files_put",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Read File",
        "operationId": "read_file_sandboxes__sandbox_id__files_get",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1,
            "title": "Protocol Version",
            "default": 1
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities",
            "default": [
              "sandbox.create",
              "sandbox.delete",
              "sandbox.exec",
              "files.read",
              "files.write",
              "events",
              "diagnostics"
            ]
          }
        },
        "type": "object",
        "title": "CapabilitiesResponse",
        "description": "Runtime protocol and feature discovery."
      },
      "CreateSandboxRequest": {
        "properties": {
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image",
            "description": "Image reference to boot. Omit to use the published image for the OS."
          },
          "os": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alpine",
                  "ubuntu"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Os",
            "description": "Guest OS. Ubuntu is the SDK default; Alpine is optional."
          },
          "memory": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 16384.0,
                "minimum": 128.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory",
            "description": "Memory in MiB."
          },
          "disk_size": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 262144.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Disk Size",
            "description": "Root disk size in MiB."
          },
          "backend": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "firecracker",
                  "qemu",
                  "libkrun",
                  "vz"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend",
            "description": "Optional runtime backend override."
          },
          "network": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpenNetworkPolicy"
              },
              {
                "$ref": "#/components/schemas/OffNetworkPolicy"
              },
              {
                "$ref": "#/components/schemas/RestrictedNetworkPolicy"
              }
            ],
            "title": "Network",
            "description": "Outbound network policy.",
            "discriminator": {
              "propertyName": "mode",
              "mapping": {
                "off": "#/components/schemas/OffNetworkPolicy",
                "open": "#/components/schemas/OpenNetworkPolicy",
                "restricted": "#/components/schemas/RestrictedNetworkPolicy"
              }
            }
          }
        },
        "type": "object",
        "title": "CreateSandboxRequest",
        "description": "Create and boot an SDK-session sandbox."
      },
      "DesktopResponse": {
        "properties": {
          "protocol": {
            "type": "string",
            "const": "vnc",
            "title": "Protocol",
            "default": "vnc"
          },
          "host": {
            "type": "string",
            "enum": [
              "127.0.0.1",
              "localhost",
              "::1"
            ],
            "title": "Host"
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port"
          },
          "viewer_url": {
            "type": "string",
            "title": "Viewer Url"
          }
        },
        "type": "object",
        "required": [
          "host",
          "port",
          "viewer_url"
        ],
        "title": "DesktopResponse",
        "description": "A sanitized loopback display endpoint for a running sandbox."
      },
      "DiagnosticsResponse": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1,
            "title": "Protocol Version",
            "default": 1
          },
          "runtime_version": {
            "type": "string",
            "title": "Runtime Version"
          },
          "python_version": {
            "type": "string",
            "title": "Python Version"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported"
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Problems",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "runtime_version",
          "python_version",
          "platform",
          "supported"
        ],
        "title": "DiagnosticsResponse",
        "description": "Safe local runtime facts suitable for a bug report."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Short explanation with a recovery action."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "The body returned for a handled API error."
      },
      "ExecRequest": {
        "properties": {
          "command": {
            "type": "string",
            "title": "Command"
          },
          "timeout": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Timeout",
            "default": 30
          },
          "shell": {
            "type": "string",
            "enum": [
              "login",
              "raw"
            ],
            "title": "Shell",
            "default": "login"
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwd",
            "description": "Absolute working directory in the guest."
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "command"
        ],
        "title": "ExecRequest",
        "description": "Run one command inside a sandbox."
      },
      "ExecResponse": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout"
          },
          "stderr": {
            "type": "string",
            "title": "Stderr"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "exit_code",
          "stdout",
          "stderr"
        ],
        "title": "ExecResponse",
        "description": "Captured command result. Non-zero exits are successful HTTP responses."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OffNetworkPolicy": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "off",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "OffNetworkPolicy",
        "description": "Block outbound network access."
      },
      "OpenNetworkPolicy": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "open",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "OpenNetworkPolicy",
        "description": "Allow all outbound network access."
      },
      "RestrictedNetworkPolicy": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "restricted",
            "title": "Mode"
          },
          "allowed_cidrs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Allowed Cidrs"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "allowed_cidrs"
        ],
        "title": "RestrictedNetworkPolicy",
        "description": "Allow outbound access only to the supplied IPv4 ranges."
      },
      "SandboxResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/VMState"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "SandboxResponse",
        "description": "Public state for one session-owned sandbox."
      },
      "VMState": {
        "type": "string",
        "enum": [
          "created",
          "running",
          "paused",
          "stopped",
          "error"
        ],
        "title": "VMState",
        "description": "VM lifecycle states."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
