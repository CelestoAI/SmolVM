        "properties": {
          "host_path": {
            "type": "string",
            "format": "path",
            "title": "Host Path"
          },
          "guest_path": {
            "type": "string",
            "title": "Guest Path",
            "default": "/workspace"
          },
          "mount_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mount Tag"
          },
          "writable": {
            "type": "boolean",
            "title": "Writable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "host_path"
        ],
        "title": "WorkspaceMount",
        "description": "Host directory to mount inside the guest via virtio-9p.\n\nBy default the host directory is exposed read-only through QEMU's\nvirtio-9p passthrough, with an overlayfs layer on top so the guest\ncan read and write freely \u2014 changes stay inside the VM and never\ntouch the host.\n\nWhen ``writable`` is True the host directory is exposed read-write\nand mounted directly at ``guest_path`` (no overlay), so writes from\nthe guest are visible on the host.\n\nAttributes:\n    host_path: Absolute path to a directory on the host.\n    guest_path: Mount point inside the guest (default ``/workspace``).\n    mount_tag: 9p mount tag passed to QEMU.  Auto-generated when omitted.\n    writable: When True, guest writes propagate to the host directory.\n        Default False (read-only host, writable overlay in guest)."
      }
    }
