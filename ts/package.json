{
  "name": "smolvm",
  "version": "0.1.0",
  "description": "TypeScript SDK for SmolVM — disposable computers for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dump-openapi": "uv run --project .. --extra dashboard python ../scripts/dump_openapi.py",
    "generate": "openapi-ts",
    "sync": "npm run dump-openapi && npm run generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:contracts": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --strict --skipLibCheck fixtures/desktop-facade.contract.ts",
    "test": "npm run typecheck && npm run test:contracts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
