# Disposable TWO-VM fixture, not a production ruleset or a runtime installer.
# Only load inside the isolated test container's network namespace.
table inet smolvm_policy_spike {
    counter guest_drops {}
    counter proxy_drops {}
    counter proxy_allowed {}
    set prohibited_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24,
            192.168.0.0/16, 192.175.48.0/24, 198.18.0.0/15,
            198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4,
            8.8.4.4
        }
    }
    chain guest0 {
        meta nfproto ipv6 counter name guest_drops drop
        ip saddr != 10.0.0.2 counter name guest_drops drop
        ip daddr 10.0.0.1 tcp dport { 18080, 8444 } accept
        ct state established ct direction reply accept
        counter name guest_drops drop
    }
    chain guest1 {
        meta nfproto ipv6 counter name guest_drops drop
        ip saddr != 10.0.0.6 counter name guest_drops drop
        ip daddr 10.0.0.5 tcp dport { 18081, 8444 } accept
        ct state established ct direction reply accept
        counter name guest_drops drop
    }
    chain input {
        type filter hook input priority -150; policy accept;
        iifname "spike-tap0" jump guest0
        iifname "spike-tap1" jump guest1
    }
    chain forward {
        type filter hook forward priority -150; policy accept;
        iifname "spike-tap0" ip saddr != 10.0.0.2 counter name guest_drops drop
        iifname "spike-tap1" ip saddr != 10.0.0.6 counter name guest_drops drop
        iifname { "spike-tap0", "spike-tap1" } meta nfproto ipv6 counter name guest_drops drop
        iifname { "spike-tap0", "spike-tap1" } ct state established ct direction reply accept
        iifname { "spike-tap0", "spike-tap1" } counter name guest_drops drop
    }
    chain proxy_output {
        meta nfproto ipv6 counter name proxy_drops drop
        # Replies to each assigned guest, not arbitrary host->guest connections.
        meta skuid 65534 ip daddr 10.0.0.2 tcp sport 18080 ct direction reply ct state established accept
        meta skuid 65533 ip daddr 10.0.0.6 tcp sport 18081 ct direction reply ct state established accept
        # Host-local negative readiness probes: replies only, never new dials.
        meta skuid 65534 ip daddr 10.0.0.1 tcp sport 18080 ct direction reply ct state established accept
        meta skuid 65533 ip daddr 10.0.0.5 tcp sport 18081 ct direction reply ct state established accept
        # Trusted resolver fixture: narrow destination and port, not a subnet.
        ip daddr 10.0.0.6 meta l4proto { tcp, udp } th dport 53 counter name proxy_allowed accept
        ip daddr @prohibited_v4 counter name proxy_drops drop
        tcp dport { 80, 443 } counter name proxy_allowed accept
        counter name proxy_drops drop
    }
    chain output {
        type filter hook output priority -150; policy accept;
        meta skuid { 65533, 65534 } jump proxy_output
    }
}
