{
  "name": "open-muse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run clean && tsc -p tsconfig.server.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "eval:validate": "tsx eval/run-deterministic.ts",
    "eval:artifact": "tsx eval/run-deterministic.ts --output artifacts/open-muse-eval.json",
    "eval:live": "tsx eval/run-live.ts",
    "eval:release-gate": "tsx eval/check-release-gate.ts",
    "dev:e2e:harness": "tsx test/e2e/harness-server.ts",
    "check": "npm run typecheck && npm test && npm run eval:validate && npm run build"
  },
  "dependencies": {
    "@celestoai/smolvm": "file:../ts",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "http-proxy": "^1.18.1",
    "playwright-core": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.30",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
